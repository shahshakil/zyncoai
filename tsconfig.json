{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@packages/*": ["packages/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "services/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "frontend/**",
    "frontend-hybrid/**",
    "frontend-hybrid copy/**",
    "*/.test.ts",
    "*/.spec.ts",
    "packages/db/jobs.ts",
    "services/worker/jobRunner.ts",
    "packages/engine/runWorkflow.ts"
  ]
}
