{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "./components/*",
        "./src/components/*"
      ],
      "@/lib/*": [
        "./lib/*",
        "./src/lib/*"
      ],
      "@/styles/*": [
        "./src/styles/*",
        "./styles/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "*/.ts",
    "*/.tsx",
    "types/**/*.d.ts",
    "*/.d.ts",
    ".next-staging/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "zyncoai-marketing",
    "zyncoai-marketing/**",
    ".next",
    "src",
    "src/**"
  ]
}
