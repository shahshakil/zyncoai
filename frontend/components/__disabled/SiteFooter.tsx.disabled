function ColBlock({ col }: { col: Col }) {
  return (
    <div>
      <div className="text-sm font-semibold text-white">{col.title}</div>
      <ul className="mt-3 space-y-2">
        {col.links.map((l) => (
          <li key={l.label}>
            <Link
              href={l.href}
              className="group inline-flex items-center gap-2 text-sm text-white/70 hover:text-white"
            >
              <span className="underline-offset-4 group-hover:underline">
                {l.label}
              </span>
              {l.badge ? (
                <span className="rounded-full border border-white/15 bg-white/5 px-2 py-0.5 text-[11px] text-white/70">
                  {l.badge}
                </span>
              ) : null}
            </Link>
          </li>
        ))}
      </ul>
    </div>
  );
}

